{
  "name": "anselmh/kirby-uniform-turnstile",
  "description": "Kirby Cloudflare Turnstile guard for the Uniform plugin",
  "type": "kirby-plugin",
  "keywords": ["kirby", "kirby-plugin", "uniform", "turnstile", "cloudflare", "captcha"],
  "homepage": "https://github.com/anselmh/kirby-uniform-turnstile",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "getkirby/composer-installer": "^1.2",
    "mzur/kirby-uniform": "^5.7"
  },
  "authors": [{
    "name": "Anselm Hannemann",
    "email": "info@anselm-hannemann.com"
  }],
  "autoload": {
    "psr-4": {
      "Uniform\\Guards\\": "src/Guards"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "extra": {
    "installer-name": "uniform-turnstile"
  },
  "require-dev": {
    "phpunit/phpunit": "^12",
    "getkirby/cms": "^5.0"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
